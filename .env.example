# =============================================================================
# Aura – Environment Variables Reference
# Copy this file to .env and fill in the values before running docker compose.
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=aura
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aura

# ── Redis ───────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD=

# ── MinIO / S3-Compatible Storage ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
S3_BUCKET=aura-media

# ── Backend ─────────────────────────────────────────────────────────────────────
# Must be a long random string in production!
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── AI Integration ──────────────────────────────────────────────────────────────
# Local Ollama (optional – for offline AI tagging)
OLLAMA_BASE_URL=http://ollama:11434

# Cloud AI (optional – pick one)
OPENAI_API_KEY=

# ── OIDC / SSO (optional) ────────────────────────────────────────────────────────
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
